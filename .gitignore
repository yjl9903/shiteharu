/production/**/research/fonts/**/*.png
/production/**/research/fonts/**/*.jpg
/production/**/research/fonts/**/*.jpeg
/production/**/research/fonts/**/*.webp
/production/**/research/fonts/**/*.zip
/production/**/research/fonts/**/*.7z
/production/**/research/fonts/**/*.tgz

# 打包交付产物；保留 deliverables/ 内的字幕和封面
