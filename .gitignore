# 系统与编辑器临时文件
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~

# 本地凭据；保留可共享的环境变量模板
.env
.env.*
!.env.example
!.env.sample
!.env.template
cookies.txt
*.cookies.txt

# 依赖与运行缓存
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.log

# 本机字体副本不提交或分发；配置只记录仓库内相对路径
/fonts/local/

