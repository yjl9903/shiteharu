# 系统与编辑器临时文件
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~

# 本地凭据；保留可共享的环境变量模板
.env
.env.*
!.env.example
!.env.sample
!.env.template
cookies.txt
*.cookies.txt

# 依赖与运行缓存
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.log

# 本机字体副本不提交或分发；配置只记录仓库内相对路径
/fonts/local/

# 下载原片、音频提取与媒体中间文件（字幕文件仍纳入版本管理）
/downloads/
/production/**/audio/
/production/**/*.mp4
/production/**/*.mkv
/production/**/*.webm
/production/**/*.mov
/production/**/*.avi
/production/**/*.m4v
/production/**/*.m4a
/production/**/*.mp3
/production/**/*.wav
/production/**/*.flac
/production/**/*.ogg
/production/**/*.opus
*.part
*.ytdl


# 可重新生成的截图、对照图与渲染缓存
/production/**/frames/
/production/**/deliverables/comparisons/**/*.png
/production/**/deliverables/comparisons/**/*.jpg
/production/**/deliverables/comparisons/**/*.jpeg
/production/**/deliverables/comparisons/**/*.webp

# 字体研究与预览的下载资源、字体副本和生成图片
# 顶层 fonts/ 中的正式字体、许可和来源记录不受这些规则影响
/production/**/font-style-preview/font-match/cache/
/production/**/font-style-preview/**/*.ttf
/production/**/font-style-preview/**/*.otf
/production/**/font-style-preview/**/*.ttc
/production/**/font-style-preview/**/*.woff
/production/**/font-style-preview/**/*.woff2
/production/**/font-style-preview/**/*.cache-*
/production/**/font-style-preview/**/*.png
/production/**/font-style-preview/**/*.jpg
/production/**/font-style-preview/**/*.jpeg
/production/**/font-style-preview/**/*.webp
/production/**/font-style-preview/**/*.zip
/production/**/font-style-preview/**/*.7z
/production/**/font-style-preview/**/*.tgz
/production/**/font-style-preview/font-match/candidates/**/*.pdf

# 打包交付产物；保留 deliverables/ 内的字幕和封面
/production/**/deliverables/*.zip
/production/**/deliverables/*.7z
/production/**/deliverables/*.tar
/production/**/deliverables/*.tar.gz
/production/**/deliverables/*.tgz
